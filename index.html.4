<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ملف انجاز الاجتماعيات</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; font-family: 'Cairo', sans-serif; margin: 0; padding: 0; }
    body { background-color: #fbcfe8; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 20px; position: relative; }
    #roleModal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(251, 207, 232, 0.98); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 1000; }
    #roleModal h2 { color: #e11d48; font-size: 1.8rem; margin-bottom: 25px; text-align: center; }
    .modal-btn { background-color: #f43f5e; color: white; border: none; padding: 12px 35px; font-size: 1.1rem; font-weight: bold; border-radius: 25px; margin: 8px; cursor: pointer; width: 220px; }
    .clouds-container { display: flex; justify-content: center; gap: 10px; margin-bottom: 10px; }
    .cloud { background: #f472b6; border-radius: 50px; padding: 12px 20px; color: #fbcfe8; font-size: 1.1rem; }
    .main-title { color: #f43f5e; font-size: 2.5rem; font-weight: 900; text-align: center; margin-top: 10px; }
    .sub-title { color: #000; font-size: 1.6rem; font-weight: 700; text-align: center; margin-bottom: 35px; }
    .sections-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 30px 15px; width: 100%; max-width: 500px; justify-items: center; }
    .section-card { display: flex; flex-direction: column; align-items: center; cursor: pointer; }
    .heart-container { position: relative; }
    .heart-icon { width: 75px; height: 75px; background: radial-gradient(circle, #ff66c4 0%, #d946ef 100%); clip-path: path('M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z'); }
    .arrow-svg { position: absolute; top: -5px; right: -10px; width: 90px; height: 90px; pointer-events: none; }
    .section-title { color: #f43f5e; font-size: 1.2rem; font-weight: 700; margin-top: 8px; text-align: center; }
    .admin-controls { margin-top: 25px; display: none; flex-direction: column; align-items: center; gap: 10px; }
    .admin-btn { background-color: #0284c7; color: white; border: none; padding: 10px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; }
    .role-badge { position: fixed; top: 15px; left: 15px; background: #ffffff; padding: 5px 15px; border-radius: 20px; font-weight: bold; color: #e11d48; }
    .image-modal { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 2000; flex-direction: column; align-items: center; padding: 20px; overflow-y: auto; }
    .image-modal-content { background: #fbcfe8; padding: 20px; border-radius: 15px; width: 90%; max-width: 500px; position: relative; margin-top: 30px; }
    .close-btn { position: absolute; top: 10px; left: 15px; font-size: 1.8rem; font-weight: bold; color: #e11d48; cursor: pointer; }
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; margin-top: 15px; }
    .gallery img { width: 100%; height: 100px; object-fit: cover; border-radius: 8px; border: 2px solid #f43f5e; }
  </style>
</head>
<body>

  <div id="roleModal">
    <h2>مرحباً بك! اختر صفة الدخول:</h2>
    <button class="modal-btn" onclick="selectRole('visitor')">دخول كـ زائر 👁️</button>
    <button class="modal-btn" onclick="selectRole('admin')">دخول كـ إدارة 🛠️</button>
  </div>

  <div class="role-badge" id="roleBadge">زائر</div>

  <div class="clouds-container">
    <div class="cloud">☁️</div>
    <div class="cloud">☁️</div>
    <div class="cloud">☁️</div>
  </div>

  <h1 class="main-title">ملف انجاز الاجتماعيات</h1>
  <h2 class="sub-title">مايا عبدالعزيز نجاش</h2>

  <div class="sections-grid" id="sectionsGrid"></div>

  <div class="admin-controls" id="adminControls">
    <button class="admin-btn" onclick="addNewSection()">+ إضافة قسم جديد 💘</button>
  </div>

  <div class="image-modal" id="imageModal">
    <div class="image-modal-content">
      <span class="close-btn" onclick="closeGallery()">&times;</span>
      <h3 id="modalTitle" style="color: #e11d48; text-align: center;"></h3>
      <div id="adminUploadArea" style="display:none; text-align: center; margin-top: 10px;">
        <input type="file" id="imageInput" accept="image/*" style="display:none;" onchange="uploadImage(event)">
        <button class="admin-btn" onclick="document.getElementById('imageInput').click()">+ رفع صورة للجميع</button>
      </div>
      <div class="gallery" id="galleryContainer"></div>
    </div>
  </div>

  <script>
    const sectionsData = {
      'sec1': { name: 'الاختبارات', images: [] },
      'sec2': { name: 'الأنشطة', images: [] },
      'sec3': { name: 'السيرة الذاتية', images: [] },
      'sec4': { name: 'المشاريع', images: [] },
      'sec5': { name: 'أنشطة لاصفية', images: [] }
    };

    let currentRole = 'visitor';
    let activeSecKey = null;

    function createHeartSVG() {
      return `
        <div class="heart-container">
          <div class="heart-icon"></div>
          <svg class="arrow-svg" viewBox="0 0 100 100">
            <path d="M 15,85 L 80,20" stroke="#00d2ff" stroke-width="8" stroke-linecap="round"/>
            <polygon points="80,20 65,22 78,35" fill="#00d2ff"/>
            <circle cx="15" cy="85" r="7" fill="#00d2ff"/>
          </svg>
        </div>
      `;
    }

    function selectRole(role) {
      currentRole = role;
      document.getElementById('roleModal').style.display = 'none';
      document.getElementById('roleBadge').innerText = role === 'admin' ? 'وضع الإدارة 🛠️' : 'وضع الزائر 👁️';
      if (role === 'admin') {
        document.getElementById('adminControls').style.display = 'flex';
      }
      renderSections();
    }

    function renderSections() {
      const grid = document.getElementById('sectionsGrid');
      grid.innerHTML = '';
      Object.keys(sectionsData).forEach(key => {
        const sec = sectionsData[key];
        const card = document.createElement('div');
        card.className = 'section-card';
        card.onclick = () => openGallery(key);
        card.innerHTML = `${createHeartSVG()}<div class="section-title">${sec.name}</div>`;
        grid.appendChild(card);
      });
    }

    function addNewSection() {
      const name = prompt("أدخل اسم القسم الجديد:");
      if (name) {
        const newKey = 'custom_' + Date.now();
        sectionsData[newKey] = { name: name, images: [] };
        renderSections();
      }
    }

    function openGallery(key) {
      activeSecKey = key;
      document.getElementById('modalTitle').innerText = sectionsData[key].name;
      document.getElementById('adminUploadArea').style.display = currentRole === 'admin' ? 'block' : 'none';
      renderGalleryImages();
      document.getElementById('imageModal').style.display = 'flex';
    }

    function closeGallery() {
      document.getElementById('imageModal').style.display = 'none';
      activeSecKey = null;
    }

    function uploadImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          sectionsData[activeSecKey].images.push(e.target.result);
          renderGalleryImages();
        };
        reader.readAsDataURL(file);
      }
    }

    function renderGalleryImages() {
      const container = document.getElementById('galleryContainer');
      container.innerHTML = '';
      const images = sectionsData[activeSecKey]?.images || [];

      if (images.length === 0) {
        container.innerHTML = '<p style="text-align:center; width:100%; color:#888;">لا توجد صور بعد.</p>';
        return;
      }

      images.forEach(imgSrc => {
        const img = document.createElement('img');
        img.src = imgSrc;
        container.appendChild(img);
      });
    }
  </script>
</body>
</html>
